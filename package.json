{
  "name": "rivergate-initiative-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:check": "node scripts/check-config.mjs development",
    "build": "vite build",
    "start": "node scripts/start-production.mjs",
    "start:check": "node scripts/check-config.mjs production",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/*.test.js",
    "test:e2e": "node --test test/e2e.docker.js",
    "docker:build": "docker build -t initiative-tracker:local .",
    "docker:run": "docker run --rm --name initiative-tracker-e2e -p 3000:3000 -e DM_PASSWORD=test-password -e PUBLIC_ORIGIN=http://127.0.0.1:3000 -e PORT=3000 -e HOST=0.0.0.0 -e TRUST_PROXY=1 -e DATABASE_PATH=/data/initiative.sqlite -v initiative-tracker-e2e-data:/data initiative-tracker:local"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.5"
  }
}
